# MandiConnect Server Environment Variables Template
# Copy this file to .env and replace placeholder values for your production deployment.

NODE_ENV=production
PORT=5000

# --- Database (MySQL 8) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=mandiconnect_user
DB_PASSWORD=your_secure_db_password_here
DB_NAME=mandi_connects

# --- Auth ---
# Generate with: openssl rand -hex 64 (must be at least 32 characters)
JWT_SECRET=your_super_secret_64_char_random_jwt_key_here
# Set to "true" in production (requires HTTPS)
COOKIE_SECURE=true

# --- Single Admin Account ---
ADMIN_EMAIL=admin@mandiconnect.com
ADMIN_PASSWORD=your_secure_admin_password_here

# --- Email (SMTP for transactional emails & password resets) ---
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_smtp_password_or_api_key

# --- Razorpay Gateway ---
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# --- CORS ---
# Comma-separated list of allowed frontend production origins
FRONTEND_URL=https://mandiconnect.com,https://www.mandiconnect.com

# --- File Storage ---
# local | cloudinary | s3
STORAGE_PROVIDER=local

# Required if STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required if STORAGE_PROVIDER=s3
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# --- Observability ---
LOG_LEVEL=info
# Sentry Error Tracking DSN (Optional)
SENTRY_DSN=
